# Supabase project — without these the app runs against a local development account
# and refuses to start in production.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show a sample exam while data/exams/ is still empty. Never set this in production.
SAMPLE_EXAMS=1

# Used only by the tagging pipeline (npm run classify).
ANTHROPIC_API_KEY=

# Only needed to run scripts/verify-rls.ts, which proves one student cannot read
# another's data. Create these two throwaway users in the Supabase dashboard with
# "Auto Confirm User" ticked, then delete them when you are done.
RLS_TEST_A_EMAIL=
RLS_TEST_A_PASSWORD=
RLS_TEST_B_EMAIL=
RLS_TEST_B_PASSWORD=
